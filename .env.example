# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://localhost:8000

# Generate two independent 64-character hex values for these API secrets.
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Comma-separated exact origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5177

# Database Configuration
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Render Secret File path, usually /etc/secrets/ca.pem
DB_SSL_CA=/etc/secrets/ca.pem
